# Application
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Database (single database name shared by Mongoose and the app)
MONGO_URI="mongodb://fitvibe:change-me@localhost:27017/fitvibe?authSource=fitvibe"
MONGODB_DB=fitvibe

# Docker Compose bootstrap credentials (not needed for local `npm run dev`)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD="change-me"
MONGO_APP_USER=fitvibe
MONGO_APP_PASSWORD="change-me"
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD="change-me"

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Google OAuth (optional; Google sign-in is disabled when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP email (OTP + purchase confirmations)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
